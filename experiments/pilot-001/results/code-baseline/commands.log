def parse_port(raw: str) -> int:
    """Parse a decimal port number in the inclusive range 1..65535."""
    value = int(raw.strip())
    if not 1 <= value <= 65535:
        raise ValueError('port out of range')
    return value
import unittest
from ports import parse_port

class PortTests(unittest.TestCase):
    def test_normal(self):
        self.assertEqual(parse_port('80'), 80)

    def test_whitespace(self):
        self.assertEqual(parse_port(' 443 '), 443)

    def test_upper_bound(self):
        self.assertEqual(parse_port('65535'), 65535)

    def test_invalid(self):
        for raw in ('0', '65536', 'abc'):
            with self.subTest(raw=raw), self.assertRaises(ValueError):
                parse_port(raw)

if __name__ == '__main__':
    unittest.main()
